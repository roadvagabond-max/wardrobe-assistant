# Google Gemini API Kulcs (AI Képfelismerés & Stylist)
# Ingyenesen generálható: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Firebase Konfiguráció (Autentikáció & Firestore Adatbázis & Storage)
# Beszerezhető: https://console.firebase.google.com/ -> Project Settings -> General -> Web App
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
