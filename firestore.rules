rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Multi-tenant user isolation: Each user can only read and write their own documents & subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // System configuration (e.g. global admin whitelist, system config)
    match /system/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny all other top-level database reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

